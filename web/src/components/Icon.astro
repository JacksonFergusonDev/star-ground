---
// The house icons, inlined so they take the text's color. Decoration only: the
// label next to an icon carries the meaning.
import arrowDown from '@house/icons/arrow-down.svg?raw';
import arrowLeft from '@house/icons/arrow-left.svg?raw';
import arrowRight from '@house/icons/arrow-right.svg?raw';
import arrowUp from '@house/icons/arrow-up.svg?raw';
import arrowUpRight from '@house/icons/arrow-up-right.svg?raw';
import brandGithub from '@house/icons/brand-github.svg?raw';
import jacksonferguson from '@house/icons/jacksonferguson.svg?raw';

const icons = {
  'arrow-down': arrowDown,
  'arrow-left': arrowLeft,
  'arrow-right': arrowRight,
  'arrow-up': arrowUp,
  'arrow-up-right': arrowUpRight,
  'brand-github': brandGithub,
  jacksonferguson,
};

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
}
const { name, size = 14 } = Astro.props;
// Replace the file's own size with ours, and hide it from assistive technology.
const svg = icons[name].replace(
  /<svg([^>]*)>/,
  (_, attrs: string) =>
    `<svg${attrs.replace(/\s(width|height)="[^"]*"/g, '')} width="${size}" height="${size}" aria-hidden="true" focusable="false" class="icon">`,
);
---

<Fragment set:html={svg} />
