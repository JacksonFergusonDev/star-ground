---
// The <head> every page shares: house styles in house-style's order, then
// Star Ground's accent, then the site's own styles.
import 'house-style/css/fonts.css';
import 'house-style/css/tokens.css';
import 'house-style/css/components.css';
import 'house-style/css/site.css';
import '@branding/theme.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | Star Ground` : 'Star Ground';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#0a0c0e" />
<meta name="description" content={description} />
<title>{pageTitle}</title>
{!noindex && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex" />}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
