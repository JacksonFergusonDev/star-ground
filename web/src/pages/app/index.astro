---
import Workspace from '../../components/workspace/Workspace.svelte';
import Base from '../../layouts/Base.astro';
---

<Base
  title="Workspace"
  description="Add the pedals you're building and get one shopping list for all of them."
  noindex
>
  <section class="section" aria-labelledby="app-title">
    <h1 id="app-title" class="app-title">
      Your builds.
    </h1>
    <p class="section-lede">
      Add each pedal you're building: upload its build document, paste a link to one, pick a preset,
      or paste a parts list. The master list merges them and updates as you go. Everything stays in
      this browser.
    </p>
    <Workspace client:only="svelte" />
  </section>
</Base>

<style>
  .app-title {
    margin: 0 0 24px;
    font-size: var(--fs-h2);
    font-weight: 500;
    letter-spacing: -1.6px;
  }
</style>
