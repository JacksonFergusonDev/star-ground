---
// A picture of the app, for other sites to show: the shopping list page as
// plain HTML, with no scripts and no requests. Its parts are the Big Muff π's,
// as the API lists them (scripts/export_snapshot.py writes them). When the site
// is built, the page's styles and fonts are written into it (see
// astro.config.mjs), so another site can fetch this one file and show it in a
// frame. jacksonferguson.me does.
import Icon from '../../components/workspace/Icon.svelte';
import MasterList from '../../components/workspace/MasterList.svelte';
import PageHead from '../../components/workspace/PageHead.svelte';
import Head from '../../components/Head.astro';
import snapshot from '../../data/shopping-list-snapshot.json';
import type { MasterListResult } from '../../lib/api';
import { views } from '../../lib/router.svelte';

const result = snapshot as MasterListResult;
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title="Shopping list snapshot"
      description="A picture of Star Ground's shopping list, for other sites to show."
      noindex
    />
  </head>
  <body>
    <!-- `app` gives the page the app's look; the snapshot class undoes its sidebar layout. -->
    <div class="app snapshot">
      <main class="app-main">
        <PageHead
          title="Shopping list"
          lede="Every project's parts in one list, less the stock you own. It updates as your projects change."
        >
          <a slot="actions" class="hs-button" href={views.export.path}>
            Export <Icon name="arrow-right" size={14} />
          </a>
        </PageHead>
        <MasterList
          {result}
          updating={false}
          error={null}
          options={{ hardware: true, extras: true }}
          display={{ notation: 'decimal', bands: 5 }}
          showHref={() => null}
        />
      </main>
    </div>
  </body>
</html>

<style>
  /* One column, no sidebar. The window still never scrolls, so a frame
     showing the page draws no scroll bars. */
  .snapshot {
    display: block;
    height: auto;
  }
</style>
