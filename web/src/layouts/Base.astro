---
// House styles load first, in house-style's order, then Star Ground's accent,
// then the site's own layout.
import 'house-style/css/fonts.css';
import 'house-style/css/tokens.css';
import 'house-style/css/components.css';
import 'house-style/css/site.css';
import '@branding/theme.css';
import '../styles/global.css';
import SiteBar from 'house-style/astro/SiteBar.astro';
import SiteFooter from 'house-style/astro/SiteFooter.astro';
import { links } from '../lib/site';

interface Props {
  title?: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | Star Ground` : 'Star Ground';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0c0e" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="hs-skip-link" href="#main">
      Skip to content
    </a>
    <SiteBar
      name="Star Ground"
      logo="/favicon.svg"
      github={links.github}
      nav={[
        { label: 'How it works', href: '/#how-it-works' },
        { label: 'Documents', href: '/#documents', wide: true },
        { label: 'Accuracy', href: '/#accuracy', wide: true },
      ]}
    />
    <main id="main" class="page">
      <slot />
    </main>
    <SiteFooter
      license={links.license}
      links={[
        { label: 'GitHub', href: links.github, icon: 'brand-github' },
        { label: 'LinkedIn', href: links.linkedin, icon: 'brand-linkedin' },
        { label: 'Email', href: links.email, icon: 'brand-email' },
      ]}
    >
      <p>
        Are you a PCB publisher? If you'd rather Star Ground didn't read your documents,{' '}
        <a href={links.email}>email me</a> and I'll take them out.
      </p>
    </SiteFooter>
  </body>
</html>
