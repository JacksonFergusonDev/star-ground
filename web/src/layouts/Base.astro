---
// The home page and the site's other standalone pages: house-style's project
// site shell around the page.
import Icon from 'house-style/astro/Icon.astro';
import SiteBar from 'house-style/astro/SiteBar.astro';
import SiteFooter from 'house-style/astro/SiteFooter.astro';
import Head from '../components/Head.astro';
import { links } from '../lib/site';

interface Props {
  title?: string;
  description: string;
  noindex?: boolean;
}
const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head {...props} />
  </head>
  <body>
    <a class="hs-skip-link" href="#main">
      Skip to content
    </a>
    <SiteBar
      name="Star Ground"
      logo="/favicon.svg"
      github={links.github}
      nav={[{ label: 'Circuit catalog', href: links.catalog }]}
    >
      <a slot="end" class="hs-bar-link hs-bar-link--accent" href={links.app}>
        Open the app <Icon name="arrow-right" size={14} />
      </a>
    </SiteBar>
    <main id="main" class="page">
      <slot />
    </main>
    <SiteFooter
      license={links.license}
      links={[
        { label: 'GitHub', href: links.github, icon: 'brand-github' },
        { label: 'LinkedIn', href: links.linkedin, icon: 'brand-linkedin' },
        { label: 'Email', href: links.email, icon: 'brand-email' },
      ]}
    >
      <p>
        Are you a PCB publisher? If you'd rather Star Ground didn't read your documents,{' '}
        <a href={links.email}>email me</a> and I'll take them out.
      </p>
    </SiteFooter>
  </body>
</html>
